# Copie este arquivo para .env.local e ajuste os valores. NUNCA versione o .env real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# URL pública da API separada (apenas quando o projeto tiver apps/api).
# Usada pelo BROWSER — em produção precisa ser HTTPS público, nunca
# "http://api:3001" (só existe dentro da rede Docker) nem localhost.
# Variáveis NEXT_PUBLIC_* são expostas ao browser — nunca coloque segredos aqui.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opcional: endereço da API só para chamadas feitas pelo SERVIDOR (Server
# Actions/Route Handlers/Server Components), ex. "http://api:3001" quando
# web e api rodam no mesmo docker-compose. Sem valor, o servidor usa
# NEXT_PUBLIC_API_URL também. Ver src/lib/api-url.ts.
API_INTERNAL_URL=

# Preenchido automaticamente no build da imagem Docker (ver .github/workflows).
APP_VERSION=0.0.0
GIT_COMMIT_SHA=local
