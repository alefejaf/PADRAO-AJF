# Copie este arquivo para .env e ajuste os valores. NUNCA versione o .env real.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Origens permitidas por CORS, separadas por vírgula. Use "*" apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Necessário apenas quando o projeto usa PostgreSQL (packages/database).
DATABASE_URL=postgres://postgres:changeme@localhost:5432/{{PROJECT_SLUG_UNDERSCORE}}

# Preenchido automaticamente no build da imagem Docker (ver .github/workflows).
APP_VERSION=0.0.0
GIT_COMMIT_SHA=local
